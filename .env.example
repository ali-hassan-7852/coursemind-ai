# Copy this file to .env and fill in real values. Never commit the real .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/coursemind

# JWT auth
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Embeddings (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# LLM provider for answer generation
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=your-groq-api-key